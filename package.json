{
  "name": "prismcast",
  "displayName": "PrismCast",
  "version": "1.10.0",
  "description": "Browser-based live TV capture server for Channels DVR, Plex, and other streaming clients.",
  "author": {
    "name": "HJD",
    "url": "https://github.com/hjdhjd"
  },
  "homepage": "https://github.com/hjdhjd/prismcast",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hjdhjd/prismcast/issues"
  },
  "keywords": [
    "browser-capture",
    "channels",
    "channels-dvr",
    "chrome",
    "chrome-capture",
    "cord-cutting",
    "dvr",
    "ffmpeg",
    "fmp4",
    "hls",
    "iptv",
    "live-streaming",
    "live-tv",
    "mpeg-ts",
    "mpegts",
    "m3u",
    "m3u8",
    "media-server",
    "ott",
    "plex",
    "puppeteer",
    "screen-capture",
    "streaming",
    "streaming-server",
    "tv",
    "video",
    "video-capture",
    "video-streaming"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/hjdhjd/prismcast.git"
  },
  "type": "module",
  "bin": {
    "prismcast": "./bin/prismcast"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "shx rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "shx rm -rf dist",
    "dev": "scripts/dev-prismcast.sh",
    "lint": "ESLINT_MAX_WARNINGS=${ESLINT_MAX_WARNINGS:--1} eslint src test eslint.config.mjs",
    "prepublishOnly": "npm run lint && npm run build",
    "start": "node dist/index.js",
    "test": "node --strip-types --test --test-force-exit --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/**/*.helpers.ts\" --experimental-test-module-mocks --test-timeout=15000 \"src/**/*.test.ts\"",
    "test:all": "npm run test && npm run test:integration",
    "test:integration": "node --strip-types --test --test-force-exit --experimental-test-module-mocks --test-timeout=120000 \"test/**/*.test.ts\"",
    "test:watch": "node --strip-types --test --experimental-test-module-mocks --watch \"src/**/*.test.ts\"",
    "watch": "npm run build && nodemon"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "5.2.1",
    "ffmpeg-for-homebridge": "2.2.2",
    "morgan": "1.10.1",
    "puppeteer-core": "24.43.0",
    "puppeteer-stream": "3.0.21"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "25.6.2",
    "eslint": "9.39.2",
    "happy-dom": "^20.9.0",
    "homebridge-plugin-utils": "1.35.0",
    "nodemon": "3.1.14",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2"
  }
}
